pragma language_version >= 0.14.0;

import CompactStandardLibrary;

export ledger minRequiredAge: Uint<32>;
export ledger totalVerifiedUsers: Counter;
export ledger contractOwner: Bytes<32>;

constructor(ownerKey: Bytes<32>, initialMinAge: Uint<32>) {
  contractOwner = disclose(ownerKey);
  minRequiredAge = disclose(initialMinAge);
}

export circuit verifyEligibility(
  secretBirthYear: Uint<32>,
  currentYear: Uint<32>,
  userSecretHash: Bytes<32>
): Boolean {
  assert(currentYear >= secretBirthYear, "Birth year cannot be in the future");
  assert((currentYear - secretBirthYear) as Uint<32> >= minRequiredAge, "Zero-Knowledge Assertion Failed: User does not meet minimum required age threshold");

  totalVerifiedUsers.increment(1);

  return disclose(true);
}

export circuit setMinimumAge(newMinAge: Uint<32>): [] {
  assert(newMinAge > 0, "Threshold must be greater than zero");
  assert(newMinAge <= 120, "Threshold must be within valid human lifespan");
  minRequiredAge = disclose(newMinAge);
}
