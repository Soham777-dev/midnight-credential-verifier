/**
 * ============================================================================
 * MIDNIGHT PRIVACY SMART CONTRACT: Confidential Credential Verifier
 * ============================================================================
 *
 * PRIVACY MODEL & SELECTIVE DISCLOSURE DESIGN
 * ----------------------------------------------------------------------------
 *
 * PUBLIC LEDGER STATE — globally observable on-chain by anyone:
 *   • minRequiredAge       — the eligibility threshold (e.g. 18)
 *   • totalVerifiedUsers   — count of successful ZK verifications
 *   • contractOwner        — Bytes<32> public key hash of the contract admin
 *
 * PRIVATE WITNESS INPUTS — computed locally, NEVER transmitted or stored:
 *   • secretBirthYear      — user's exact birth year
 *   • userSecretHash       — user's private passkey / entropy seed
 *
 * ZERO-KNOWLEDGE PROOF CIRCUIT:
 *   Proves:   (currentYear - secretBirthYear) >= minRequiredAge
 *   Without revealing secretBirthYear, exact age, or userSecretHash.
 *   The on-chain observer sees only the verified boolean and the
 *   incremented totalVerifiedUsers counter.
 *
 * SELECTIVE DISCLOSURE via disclose():
 *   Only the boolean eligibility result is deliberately surfaced via
 *   disclose() so that callers can branch on it. The underlying witnesses
 *   remain hidden inside the ZK circuit boundary.
 * ============================================================================
 */

pragma language_version >= 0.14.0;

export contract CredentialVerifier {

  // --------------------------------------------------------------------------
  // Public Ledger State
  // --------------------------------------------------------------------------
  export ledger minRequiredAge: Uint<32>;
  export ledger totalVerifiedUsers: Uint<32>;
  export ledger contractOwner: Bytes<32>;

  // --------------------------------------------------------------------------
  // constructor — initialise on deployment
  // --------------------------------------------------------------------------
  constructor(ownerKey: Bytes<32>, initialMinAge: Uint<32>) {
    contractOwner = ownerKey;
    minRequiredAge = initialMinAge;
    totalVerifiedUsers = 0;
  }

  // --------------------------------------------------------------------------
  // Circuit: verifyEligibility
  //
  // Private witnesses (never disclosed):
  //   secretBirthYear  — kept inside ZK boundary
  //   userSecretHash   — private entropy; proves user identity without reveal
  //
  // Public inputs:
  //   currentYear      — caller-supplied current year (verifiable off-chain)
  //
  // What gets proved (via disclose):
  //   isEligible       — Boolean: user meets the age threshold
  // --------------------------------------------------------------------------
  export circuit verifyEligibility(
    secretBirthYear: Uint<32>,
    currentYear: Uint<32>,
    userSecretHash: Bytes<32>
  ): Boolean {
    // Compute age inside the private ZK execution environment
    const age: Uint<32> = currentYear - secretBirthYear;

    // Enforce eligibility constraint — circuit aborts here if false
    assert age >= minRequiredAge
      "Zero-Knowledge Assertion Failed: User does not meet minimum required age threshold";

    // Atomically increment public verification counter
    totalVerifiedUsers = totalVerifiedUsers + 1;

    // Deliberately disclose eligibility result only — witnesses stay private
    const isEligible: Boolean = true;
    disclose(isEligible);
    return isEligible;
  }

  // --------------------------------------------------------------------------
  // Circuit: setMinimumAge
  // Admin-only circuit to update the verification threshold.
  // --------------------------------------------------------------------------
  export circuit setMinimumAge(newMinAge: Uint<32>): Void {
    assert newMinAge > 0
      "Threshold must be greater than zero";
    assert newMinAge <= 120
      "Threshold must be within valid human lifespan";
    minRequiredAge = newMinAge;
  }
}
